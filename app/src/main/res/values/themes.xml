<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexora_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/nexora_neon_blue</item>
    </style>

    <!-- Home screen: the system wallpaper shows through the window. -->
    <style name="Theme.Nexora.Launcher" parent="Theme.Nexora">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
